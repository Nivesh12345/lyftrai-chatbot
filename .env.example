# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-key,your-second-key
# Primary LiteLLM model name (kept for compatibility).
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional comma-separated ordered model pool. Each model is tried with every key.
LLM_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3.8-flash,gemini/gemini-3.1-flash-lite
# SQLite file; the /data folder is a Docker volume so history survives restarts.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (the frontend URL(s)).
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure test header. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true
# LiteLLM cache: "local" (in-memory) or "disk" (kept in the /data volume).
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
REQUEST_TIMEOUT=30
# Frontend build-time variable: public URL of the backend.
VITE_API_URL=http://localhost:8000
